{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme",
  "description": "日本語に最適化されたデザイントークン。Minor Third タイポグラフィスケール + 行間調整。",
  "cssVars": {
    "theme": {
      "font-sans": "Inter, Noto Sans JP, ui-sans-serif, system-ui, sans-serif",
      "text-ui": "0.875rem",
      "text-ui--line-height": "2",
      "text-body": "1rem",
      "text-body--line-height": "2.5",
      "text-h4": "1.1875rem",
      "text-h3": "1.4375rem",
      "text-h2": "1.75rem",
      "text-h1": "2.0625rem",
      "radius-sm": "calc(var(--radius) - 4px)",
      "radius-md": "calc(var(--radius) - 2px)",
      "radius-lg": "var(--radius)",
      "radius-xl": "calc(var(--radius) + 4px)"
    },
    "light": {
      "background": "#ffffff",
      "foreground": "#333333",
      "primary": "#1c1917",
      "primary-foreground": "#ffffff",
      "secondary": "#f5f5f4",
      "secondary-foreground": "#0c0a09",
      "muted": "#f5f5f4",
      "muted-foreground": "#78716c",
      "accent": "#f5f5f4",
      "accent-foreground": "#0c0a09",
      "destructive": "#e7000b",
      "destructive-foreground": "#ffffff",
      "border": "#e7e5e4",
      "input": "#e7e5e4",
      "ring": "#0c0a09",
      "radius": "0.5rem"
    },
    "dark": {
      "background": "#0c0a09",
      "foreground": "#fafaf9",
      "primary": "#fafaf9",
      "primary-foreground": "#0c0a09",
      "secondary": "#292524",
      "secondary-foreground": "#fafaf9",
      "muted": "#292524",
      "muted-foreground": "#a8a29e",
      "accent": "#292524",
      "accent-foreground": "#fafaf9",
      "destructive": "#e7000b",
      "destructive-foreground": "#ffffff",
      "border": "#292524",
      "input": "#292524",
      "ring": "#d6d3d1",
      "radius": "0.5rem"
    }
  },
  "type": "registry:theme"
}